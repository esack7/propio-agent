{
  "name": "@propio-ai/agent",
  "version": "1.1.4",
  "description": "Multi-provider AI agent CLI supporting Ollama, Bedrock, OpenRouter, OpenAI, Meta, Gemini, xAI, Cloudflare, and Anthropic",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "import": "./dist/skills/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./*": "./*"
  },
  "bin": {
    "propio": "./bin/propio.cjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esack7/propio-agent.git"
  },
  "homepage": "https://github.com/esack7/propio-agent#readme",
  "bugs": {
    "url": "https://github.com/esack7/propio-agent/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "ollama",
    "bedrock",
    "openrouter",
    "openai",
    "meta",
    "gemini",
    "xai",
    "cloudflare",
    "anthropic"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "examples/context-consumer.mjs",
    "examples/skills-consumer.mjs",
    "examples/mcp-consumer.mjs",
    "bin/propio.cjs",
    "bin/propio-sandbox",
    "docker-compose.yml",
    "Dockerfile",
    "LICENSE",
    "README.md",
    "npm-shrinkwrap.json",
    "examples/tools-consumer.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "example:context": "node examples/context-consumer.mjs",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --watch",
    "test:openrouter": "NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest openrouter",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fallow:check": "fallow --fail-on-issues",
    "fallow:audit": "fallow audit --gate all",
    "example:skills": "node examples/skills-consumer.mjs",
    "example:mcp": "node examples/mcp-consumer.mjs",
    "example:tools": "node examples/tools-consumer.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@propio-ai/providers": "0.2.0",
    "chalk": "5.6.2",
    "cli-highlight": "^2.1.11",
    "fast-glob": "3.3.3",
    "marked": "^18.0.5",
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0",
    "yocto-spinner": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "fallow": "3.3.0",
    "jest": "30.4.2",
    "prettier": "3.9.4",
    "semantic-release": "25.0.8",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
